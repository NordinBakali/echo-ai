# Gemini API bridge example (Node)
# GEMINI_API_KEY=plak_hier_je_gemini_api_key
# GEMINI_MODEL=gemini-1.5-flash
# ELEVENLABS_API_KEY=plak_hier_je_elevenlabs_api_key
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_DEFAULT_VOICE_ID=

# Cloud provider example
# OPENAI_API_KEY=plak_hier_je_api_key
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama example
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:3b
# OPENAI_TIMEOUT_SECONDS=180

# Human-like cloud TTS (Google Cloud Text-to-Speech)
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=plak_hier_je_google_tts_key
# GOOGLE_TTS_VOICE=en-US-Neural2-F
# GOOGLE_TTS_SPEED=1.0
# GOOGLE_TTS_PITCH=0.0

# Local Whisper STT (speech-to-text)
# STT_PROVIDER=whisper
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=true